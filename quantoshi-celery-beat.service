[Unit]
Description=Quantoshi Celery Beat Scheduler
After=redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/quantoshi
Environment=PYTHONPATH=/opt/quantoshi:/opt/quantoshi/btc_web
ExecStart=/opt/quantoshi/btc_venv/bin/celery -A btc_web.celery_app beat --loglevel=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
