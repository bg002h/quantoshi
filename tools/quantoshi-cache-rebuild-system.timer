# quantoshi-cache-rebuild-system.timer — quarterly cache rebuild timer (SYSTEM-level).
#
# Pair with quantoshi-cache-rebuild-system.service.
# See that file for install instructions.

[Unit]
Description=Quarterly (~90-day) cache rebuild timer

[Timer]
# Every ~90 CALENDAR days at 03:00 — quarterly, anchored to the 25th.
# Intervals: 92, 92, 89, 91 days. Verify with:
#   systemd-analyze calendar --iterations=5 '*-01,04,07,10-25 03:00:00'
OnCalendar=*-01,04,07,10-25 03:00:00
# Catch up a window missed because the machine was powered off at 03:00.
# This is the ONLY case where the rebuild starts at a time other than 03:00:
# systemd triggers it at the next boot instead. That is unavoidable — a box
# that is off at 03:00 can only run the job at some other hour — but it is
# made tolerable by the Nice=/CPUWeight=/IOSchedulingClass= settings in
# quantoshi-cache-rebuild-system.service, which keep an 8-hour rebuild from
# competing with interactive work. Do not remove those without revisiting
# this. Requires OnCalendar= to have any effect at all.
#
# Note the stamp file (/var/lib/systemd/timers/stamp-*.timer) is written when
# the timer TRIGGERS, not when the run succeeds — a failed rebuild is not
# retried by Persistent=, it waits for the next quarter.
Persistent=true
Unit=quantoshi-cache-rebuild.service

# ── Do NOT add OnBootSec= or OnUnitActiveSec= here ───────────────────────
# Both were present until 2026-07-26 and both were wrong:
#
#   OnBootSec=6h        The comment claimed "first run ~6h after enabling".
#                       It is not: systemd.timer(5) says a timer "will
#                       trigger whenever ANY of the specified timer
#                       expressions elapse", so this leg re-armed on every
#                       boot. It launched an unattended 8-hour, 22-worker
#                       rebuild 6h into a workday session — which is what
#                       exposed all of this.
#
#   OnUnitActiveSec=90d Relative to "when the unit ... was last activated" —
#                       uptime-relative, not calendar-relative, and systemd
#                       does not persist activation timestamps across
#                       reboots. With no prior activation there is no
#                       reference point, so this leg had never once fired in
#                       the timer's entire installed life; OnBootSec was
#                       doing all the work. On a box that reboots regularly
#                       it means "never".
#
# Persistent= was also inert before this rewrite, since it "only has an
# effect on timers configured with OnCalendar=" and there was none. It is
# now enabled deliberately (see above), not left over from the old config.

[Install]
WantedBy=timers.target
